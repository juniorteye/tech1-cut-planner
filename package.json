{
  "name": "tech1-workshop-cut-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:client": "next build && node --env-file=.env.local e2e/client-journey.mjs",
    "test:banding": "next build && node --env-file=.env.local e2e/banding-journey.mjs",
    "test:sections": "next build && node --env-file=.env.local e2e/sections-journey.mjs",
    "test:dev-errors": "node --env-file=.env.local e2e/dev-errors.mjs",
    "test:entry": "next build && node --env-file=.env.local e2e/entry-journey.mjs",
    "test:all": "npm test && next build && node --env-file=.env.local e2e/client-journey.mjs && node --env-file=.env.local e2e/banding-journey.mjs && node --env-file=.env.local e2e/sections-journey.mjs && node --env-file=.env.local e2e/entry-journey.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "logo": "node scripts/make-logo-images.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
