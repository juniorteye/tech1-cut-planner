# Supabase project URL and publishable key (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Used by npm run db:migrate. Never prefix with NEXT_PUBLIC_
SUPABASE_ACCESS_TOKEN=
